{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "home-dashboard",
  "compatibility_date": "2026-09-30",
  // Worker for /api/* only; everything else is served straight from the built assets.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Access guards the workers.dev hostname only; preview URLs (<version>-<name>.….workers.dev)
  // would skip it. Without this line every deploy turns them back on.
  "preview_urls": false,
  // Workers Logs store logs on Cloudflare; keep them off (debug with `wrangler tail`).
  "observability": { "enabled": false }
}
